{
  "format_id": "lotte.usage.v1", "issuer": "롯데카드", "source_type": "usage_history",
  "settlement_default": "confirmed",
  "sheet": { "select": "by_index", "index": 0 },
  "rows": { "start": 8, "rules": [ { "when": "col_empty", "col": 0, "action": "break" }, { "when": "col_contains", "col": 0, "value": "■", "action": "break" } ] },
  "columns": { "date": 0, "merchant": 3, "amount": 5, "installment_flag": 6, "installment_months": 7, "approval": 8 },
  "transforms": { "date": { "fn": "dot_ymd" }, "merchant": { "fn": "raw" }, "amount": { "fn": "amount_num" }, "installment_flag": { "fn": "raw_equals", "value": "할부" }, "installment_months": { "fn": "dash_or_first_int" }, "approval": { "fn": "str_or_null" } },
  "cancelled": { "fn": "raw_not_equals", "col": 9, "value": "N" }
}

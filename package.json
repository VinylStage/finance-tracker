{
  "name": "finance-tracker",
  "version": "0.6.0",
  "private": true,
  "description": "Personal finance tracker — local web app (Express + SQLite + React)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "cd client && npm run build",
    "test": "node --test",
    "test:coverage": "c8 --all --src src --reporter=text --reporter=html --check-coverage --lines 75 --branches 65 --functions 75 --statements 75 node --test",
    "perf:baseline": "npm run build && node scripts/lighthouse-baseline.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.0",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1"
  }
}

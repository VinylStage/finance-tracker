{
  "name": "finance-tracker",
  "version": "0.10.0",
  "private": true,
  "description": "Personal finance tracker — local web app (Express + SQLite + React)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "cd client && npm run build",
    "test": "node --test --test-timeout=60000",
    "test:coverage": "c8 --all --src src --reporter=text --reporter=html --check-coverage --lines 80 --branches 75 --functions 85 --statements 80 node --test --test-timeout=60000",
    "perf:baseline": "npm run build && node scripts/lighthouse-baseline.mjs",
    "lint": "eslint .",
    "docs:inventory": "node scripts/gen-inventory.js",
    "docs:inventory:check": "node scripts/gen-inventory.js --check",
    "docs:check": "node scripts/check-docs.js",
    "docs:erd": "node scripts/gen-erd.js",
    "docs:erd:check": "node scripts/gen-erd.js --check",
    "test:ports": "node scripts/check-test-ports.js",
    "measure:startup": "node scripts/measure-server-startup.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1"
  }
}
